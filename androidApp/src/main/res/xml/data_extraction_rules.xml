<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 o posterior. En la nube no se copia la biblioteca (la música no cabe); al pasar a
     un móvil nuevo con cable o wifi, sí: canciones, carátulas, notas, rankings e historial. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="biblioteca/" />
        <exclude domain="database" path="freedomplayer.db" />
        <exclude domain="database" path="freedomplayer.db-wal" />
        <exclude domain="database" path="freedomplayer.db-shm" />
        <exclude domain="database" path="freedomplayer.db-journal" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="biblioteca/partial/" />
    </device-transfer>
</data-extraction-rules>
